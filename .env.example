APP_NAME=RazzanStore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=id
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=razzanstore
DB_USERNAME=razzanstore_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Configure secrets only in local .env or a secure secret manager.
# Never commit real provider credentials.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
TRACKING_TOKEN_KEY=
TRACKING_TOKEN_TTL_DAYS=90
IDEMPOTENCY_RETENTION_DAYS=30
ORDER_EXPIRY_MINUTES=60
MIDTRANS_CONNECT_TIMEOUT=5
MIDTRANS_TIMEOUT=15
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=

VITE_APP_NAME=RazzanStore
